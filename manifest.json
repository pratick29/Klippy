{
  "manifest_version": 3,
  "name": "Klippy - Clip it. Keep it. Copy it.",
  "version": "2.0.0",
  "description": "Your personal vault for profile links, passwords, API keys & notes. Auto-detects profiles. One-click copy. Secured with master password.",
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardWrite",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Klippy - Clip it. Keep it. Copy it.",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Option+C"
      },
      "description": "Open Klippy Vault"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
